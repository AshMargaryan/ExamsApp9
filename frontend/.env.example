# Backend API base URL.
VITE_API_URL=http://localhost:8000/api

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add http://localhost:3000 to "Authorized JavaScript
# origins" — Google allows plain localhost for this, no HTTPS needed in dev.
# Must match the backend's GOOGLE_OAUTH_CLIENT_ID (same client).
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple — see backend/.env.example for how to obtain these.
# Cannot be tested against localhost; requires a real HTTPS domain
# registered as the Services ID's website/return URL.
VITE_APPLE_CLIENT_ID=
# Must exactly match the return URL registered on the Services ID.
VITE_APPLE_REDIRECT_URI=
