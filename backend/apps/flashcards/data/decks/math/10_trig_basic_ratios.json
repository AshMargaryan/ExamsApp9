{
  "deck_id": "FC-MATH-TRIG1-001",
  "title": "Եռանկյունաչափություն — հիմնական հարաբերություններ",
  "subject": "math",
  "cards": [
    {
      "number": 1,
      "topic": "Հիմնական հարաբերություններ",
      "front": "Ինչպե՞ս ես սահմանում $\\sin\\alpha$-ն ուղղանկյուն եռանկյան մեջ",
      "back": "$$\\sin\\alpha = \\dfrac{\\text{հակառակ էջ}}{\\text{հիպոտենուս}}$$",
      "hint": ""
    },
    {
      "number": 2,
      "topic": "Հիմնական հարաբերություններ",
      "front": "Ինչպե՞ս ես սահմանում $\\cos\\alpha$-ն ուղղանկյուն եռանկյան մեջ",
      "back": "$$\\cos\\alpha = \\dfrac{\\text{կից էջ}}{\\text{հիպոտենուս}}$$",
      "hint": "Նույն տրամաբանությունն է, ինչ $\\sin\\alpha$-ինը, միայն հակառակ էջի փոխարեն վերցնում ես կից էջը"
    },
    {
      "number": 3,
      "topic": "Հիմնական հարաբերություններ",
      "front": "Ինչպե՞ս է $\\tan\\alpha$-ն կապված $\\sin\\alpha$-ի և $\\cos\\alpha$-ի հետ",
      "back": "$$\\tan\\alpha = \\dfrac{\\sin\\alpha}{\\cos\\alpha} = \\dfrac{\\text{հակառակ էջ}}{\\text{կից էջ}}$$",
      "hint": "Գոյություն չունի, երբ $\\cos\\alpha=0$ (այսինքն՝ $\\alpha=90°+180°n$)"
    },
    {
      "number": 4,
      "topic": "Հիմնական հարաբերություններ",
      "front": "Ի՞նչ է $\\cot\\alpha$-ն, և ինչպես է կապված $\\tan\\alpha$-ի հետ",
      "back": "$$\\cot\\alpha = \\dfrac{\\cos\\alpha}{\\sin\\alpha} = \\dfrac{1}{\\tan\\alpha}$$",
      "hint": ""
    },
    {
      "number": 5,
      "topic": "Հիմնական նույնություններ",
      "front": "Ո՞րն է եռանկյունաչափության հիմնական նույնությունը, և որտեղից է այն գալիս",
      "back": "$$\\sin^2\\alpha + \\cos^2\\alpha = 1$$",
      "hint": "Ուղիղ բխում է Պյութագորասի թեորեմից՝ $a^2+b^2=c^2$-ը բաժանելով $c^2$-ի վրա"
    }
  ]
}
