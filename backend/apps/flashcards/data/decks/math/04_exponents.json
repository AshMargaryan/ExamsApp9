{
  "deck_id": "FC-MATH-EXP-001",
  "title": "Աստիճաններ",
  "subject": "math",
  "cards": [
    {
      "number": 1,
      "topic": "Աստիճաններ",
      "front": "Ինչպե՞ս ես բազմապատկում նույն հիմքով աստիճանները՝ $a^m \\cdot a^n$",
      "back": "$$a^m \\cdot a^n = a^{m+n}$$",
      "hint": "Ցուցիչները գումարվում են, հիմքը մնում է նույնը"
    },
    {
      "number": 2,
      "topic": "Աստիճաններ",
      "front": "Ինչպե՞ս ես բաժանում նույն հիմքով աստիճանները՝ $a^m : a^n$",
      "back": "$$\\dfrac{a^m}{a^n} = a^{m-n}$$",
      "hint": "Ցուցիչները հանվում են"
    },
    {
      "number": 3,
      "topic": "Աստիճաններ",
      "front": "Ի՞նչ է նշանակում բացասական ցուցիչը՝ $a^{-n}$",
      "back": "$$a^{-n} = \\dfrac{1}{a^n}, \\quad a \\ne 0$$",
      "hint": "Բացասական ցուցիչը \"շրջում է\" կոտորակը, նշանը չի փոխում թիվը բացասականի"
    },
    {
      "number": 4,
      "topic": "Աստիճաններ",
      "front": "Ինչպե՞ս ես մեկնաբանում կոտորակային ցուցիչը՝ $a^{\\frac{1}{n}}$",
      "back": "$$a^{\\frac{1}{n}} = \\sqrt[n]{a}$$",
      "hint": "Ընդհանրապես՝ $a^{\\frac{m}{n}} = \\sqrt[n]{a^m}$"
    },
    {
      "number": 5,
      "topic": "Աստիճաններ",
      "front": "Ինչի՞ է հավասար $(a^m)^n$",
      "back": "$$(a^m)^n = a^{mn}$$",
      "hint": "Հաճախակի սխալ՝ շփոթում են $a^m \\cdot a^n = a^{m+n}$ կանոնի հետ"
    }
  ]
}
