{
  "deck_id": "FC-MATH-LOG-001",
  "title": "Լոգարիթմներ",
  "subject": "math",
  "cards": [
    {
      "number": 1,
      "topic": "Լոգարիթմներ",
      "front": "Ի՞նչ է նշանակում $\\log_a b = c$",
      "back": "$$\\log_a b = c \\iff a^c = b \\quad (a>0,\\ a\\ne 1,\\ b>0)$$",
      "hint": "Լոգարիթմը հարցնում է. \"Ո՞ր աստիճանով պիտի բարձրացնեմ $a$-ն, որ ստանամ $b$\""
    },
    {
      "number": 2,
      "topic": "Լոգարիթմներ",
      "front": "Ինչպե՞ս ես տրոհում արտադրյալի լոգարիթմը՝ $\\log_a(xy)$",
      "back": "$$\\log_a(xy) = \\log_a x + \\log_a y$$",
      "hint": "Արտադրյալի լոգարիթմ → գումար. մի շփոթիր գումարի լոգարիթմի հետ (այն չի տրոհվում)"
    },
    {
      "number": 3,
      "topic": "Լոգարիթմներ",
      "front": "Ինչպե՞ս ես տրոհում քանորդի լոգարիթմը՝ $\\log_a\\dfrac{x}{y}$",
      "back": "$$\\log_a\\dfrac{x}{y} = \\log_a x - \\log_a y$$",
      "hint": ""
    },
    {
      "number": 4,
      "topic": "Լոգարիթմներ",
      "front": "Ինչպե՞ս ես հանում ցուցիչը լոգարիթմից՝ $\\log_a(x^n)$",
      "back": "$$\\log_a(x^n) = n\\log_a x$$",
      "hint": "Ցուցիչը դառնում է արտադրիչ"
    },
    {
      "number": 5,
      "topic": "Լոգարիթմներ",
      "front": "Ինչպե՞ս ես անցնում լոգարիթմի այլ հիմքի",
      "back": "$$\\log_a b = \\dfrac{\\log_c b}{\\log_c a}$$",
      "hint": "Օգտակար է, երբ հաշվիչը կամ բանաձևը միայն որոշակի հիմքով լոգարիթմ է ընդունում"
    },
    {
      "number": 6,
      "topic": "Լոգարիթմներ",
      "front": "Ինչի՞ է հավասար $\\log_a a$ և $\\log_a 1$",
      "back": "$$\\log_a a = 1, \\qquad \\log_a 1 = 0$$",
      "hint": "Բխում է անմիջապես սահմանումից՝ $a^1=a$ և $a^0=1$"
    }
  ]
}
