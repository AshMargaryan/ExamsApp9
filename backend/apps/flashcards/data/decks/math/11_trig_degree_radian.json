  "title": "Եռանկյունաչափություն — աստիճան և ռադիան",
  "subject": "math",
  "cards": [
    {
      "number": 1,
      "topic": "Աստիճան ↔ ռադիան",
      "front": "Քանի՞ ռադիան է $180°$-ը, և ինչո՞ւ է սա հենակետային արժեք",
      "back": "$$180° = \\pi \\text{ ռադիան}$$",
      "hint": "Բոլոր մյուս փոխարկումները ստացվում ես սրանից՝ $1° = \\dfrac{\\pi}{180}$ ռադիան"
    },
    {
      "number": 2,
      "topic": "Աստիճան ↔ ռադիան",
      "front": "Քանի՞ ռադիան է $90°$-ը",
      "back": "$$90° = \\dfrac{\\pi}{2}$$",
      "hint": ""
    },
    {
      "number": 3,
      "topic": "Աստիճան ↔ ռադիան",
      "front": "Քանի՞ ռադիան են $60°$, $45°$ և $30°$-ը",
      "back": "$$60° = \\dfrac{\\pi}{3}, \\quad 45° = \\dfrac{\\pi}{4}, \\quad 30° = \\dfrac{\\pi}{6}$$",
      "hint": "Հայտարարը մեծանում է, երբ անկյունը փոքրանում է"
    },
    {
      "number": 4,
      "topic": "Աստիճան ↔ ռադիան",
      "front": "Ինչպե՞ս ես ընդհանուր դեպքում փոխարկում աստիճանը ռադիանի և հակառակը",
      "back": "$$\\text{ռադիան} = \\text{աստիճան} \\times \\dfrac{\\pi}{180}, \\qquad \\text{աստիճան} = \\text{ռադիան} \\times \\dfrac{180}{\\pi}$$",
      "hint": ""
    }
  ]
