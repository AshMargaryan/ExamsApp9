# If a generated value contains a literal "$", escape it as "$$" — Docker
# Compose interpolates $VAR/${VAR} syntax inside values loaded via env_file,
# so an unescaped "$" followed by a letter (e.g. "$i") gets silently
# replaced with an empty string instead of passed through as-is.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Mirror of the three DB_* values above, using the exact variable names the
# official postgres Docker image expects (POSTGRES_DB/USER/PASSWORD). Both
# the `db` and `backend` services in docker-compose.yml read this same file,
# so there is still only one place to update the password.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

JWT_SECRET=

AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=App <noreply@example.com>