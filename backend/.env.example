# If a generated value contains a literal "$", escape it as "$$" — Docker
# Compose interpolates $VAR/${VAR} syntax inside values loaded via env_file,
# so an unescaped "$" followed by a letter (e.g. "$i") gets silently
# replaced with an empty string instead of passed through as-is.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Mirror of the three DB_* values above, using the exact variable names the
# official postgres Docker image expects (POSTGRES_DB/USER/PASSWORD). Both
# the `db` and `backend` services in docker-compose.yml read this same file,
# so there is still only one place to update the password.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

JWT_SECRET=

AI_PROVIDER=mock
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Armenian voice sidecar (see voice_benchmark/ at repo root) — STT/TTS proxy target.
VOICE_SERVICE_URL=http://localhost:8100

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# capacitor://localhost is the origin an iOS Capacitor WebView sends; without it
# every API call from the installed app fails CORS before it reaches a view.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost

# ---------------------------------------------------------------------------
# Transport security — MUST be turned on in production
# ---------------------------------------------------------------------------
# Left off below because these values are the *development* defaults, and
# because the deployment currently serves plain HTTP on port 80 (nginx/
# nginx.conf has no 443 listener). Enabling SECURE_SSL_REDIRECT before a
# certificate exists redirects every request to an https:// URL nothing is
# listening on — i.e. takes the site down.
#
# The moment TLS is in place, set all four to the values in the comments.
# Until then, passwords and JWTs cross the network in cleartext.
#
# Verify with:  python manage.py check --deploy
SECURE_SSL_REDIRECT=False       # prod: True
SESSION_COOKIE_SECURE=False     # prod: True
CSRF_COOKIE_SECURE=False        # prod: True
SECURE_HSTS_SECONDS=0           # prod: 31536000 (1 year)

# Origins allowed to make cookie-authenticated POSTs to the Django admin.
# Must include the scheme, e.g. https://gitus.am
CSRF_TRUSTED_ORIGINS=

# Where the Django admin is mounted. Keep the trailing slash. Change this in
# production: /admin/ is the first path every automated scanner tries, and
# the admin login is plain Django auth — the DRF rate limits that protect
# /api/auth/login/ do NOT apply to it, so guessing there is unbounded.
# Pair this with an IP allowlist on the /admin/ location in nginx/nginx.conf
# if the admin only needs to be reachable from known addresses.
ADMIN_URL_PATH=admin/

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Works against http://localhost during development.
GOOGLE_OAUTH_CLIENT_ID=

# Sign in with Apple. Requires an Apple Developer account (developer.apple.com).
# Unlike Google, Apple will NOT accept http://localhost anywhere — you need a
# real HTTPS domain registered as your Services ID's website/return URL
# before this can be tested end-to-end.
#   APPLE_OAUTH_CLIENT_ID:     Certificates, Identifiers & Profiles >
#                              Identifiers > Services IDs — the Services ID
#                              you register (looks like "com.example.app.web").
#   APPLE_OAUTH_TEAM_ID:       Membership page — your 10-character Team ID.
#   APPLE_OAUTH_KEY_ID:        Certificates, Identifiers & Profiles > Keys —
#                              the Key ID of a key with "Sign in with Apple" enabled.
#   APPLE_OAUTH_PRIVATE_KEY:   The .p8 private key file downloaded when you
#                              created that key, pasted with literal "\n" for
#                              newlines (Django-environ reads it as one line).
#   APPLE_OAUTH_REDIRECT_URI:  The HTTPS return URL you register on the
#                              Services ID (e.g. https://your-domain.com/).
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=App <noreply@example.com>