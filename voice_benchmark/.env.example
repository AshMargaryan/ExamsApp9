# Copy to .env and fill in. Follows the same naming style as backend/.env.example.

# Where converted CTranslate2 models + HF cache are kept, so they are not
# re-downloaded/re-converted on every server restart.
MODEL_CACHE_DIR=./model_cache

# Required for the production voice endpoints (/api/stt/transcribe,
# /api/tts/synthesize) that the real Django app calls — gpt-4o-mini-transcribe
# for STT and gpt-4o-mini-tts for TTS. Get a key at platform.openai.com.
OPENAI_API_KEY=

# Optional: Azure Speech (benchmark-only). If unset, /api/stt/benchmark still
# runs with the local Whisper models and the TTS benchmark page will explain
# how to enable it. No longer used on the production request path.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
